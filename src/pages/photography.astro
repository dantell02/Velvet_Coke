---
import BaseLayout from "../layouts/BaseLayout.astro";

// Add your image filenames here as you populate the folder
// Drop photos into public/photos/analog/
const photos = [
    { src: "/photos/analog/001.jpg", alt: "001" },
    { src: "/photos/analog/002.jpg", alt: "002" },
    { src: "/photos/analog/003.jpg", alt: "003" },
    { src: "/photos/analog/004.jpg", alt: "004" },
    { src: "/photos/analog/005.jpg", alt: "005" },
    { src: "/photos/analog/006.jpg", alt: "006" },
    { src: "/photos/analog/007.jpg", alt: "007" },
    { src: "/photos/analog/008.jpg", alt: "008" },
];
---

<BaseLayout title="Photography — Velvet Coke">
    <!-- ─── HEADER ────────────────────────────────────────────── -->
    <div class="analog-header">
        <span class="analog-title">ANALOG</span>
        <span class="analog-sub">film / grain / light</span>
    </div>

    <!-- ─── GRID ─────────────────────────────────────────────── -->
    <!-- 4 columns, square cells, Sol LeWitt systematic layout -->
    <div class="photo-grid">
        {
            photos.map((photo, i) => (
                <button
                    class="grid-cell"
                    data-index={i}
                    aria-label={`Open photo ${i + 1}`}
                >
                    <img
                        src={photo.src}
                        alt={photo.alt}
                        loading="lazy"
                        draggable="false"
                    />
                </button>
            ))
        }
    </div>

    <!-- ─── LIGHTBOX ──────────────────────────────────────────── -->
    <!-- Hidden by default, opens on grid cell click -->
    <div class="lightbox" id="lightbox" aria-hidden="true">
        <button class="lightbox-close" id="lightbox-close" aria-label="Close"
            >✕</button
        >

        <button
            class="lightbox-arrow left"
            id="lightbox-prev"
            aria-label="Previous">←</button
        >
        <button
            class="lightbox-arrow right"
            id="lightbox-next"
            aria-label="Next">→</button
        >

        <div class="lightbox-track" id="lightbox-track">
            {
                photos.map((photo, i) => (
                    <div class="lightbox-slide" data-index={i}>
                        <img
                            src={photo.src}
                            alt={photo.alt}
                            draggable="false"
                        />
                    </div>
                ))
            }
        </div>

        <div class="lightbox-counter" id="lightbox-counter">
            1 / {photos.length}
        </div>
    </div>

    <!-- ─── STYLES ────────────────────────────────────────────── -->
    <style is:global>
        /* === PAGE BACKGROUND: white for this page only === */
        /* Force light-mode variable values regardless of theme toggle, since this page always has a white background. */
        body {
            --text-primary: black;
            --text-secondary: #333;
            --text-muted: #555;
            --border-color: #ccc;
            --bg-secondary: #f0f0f0;
            background: white;
            color: black;
        }

        /* === HEADER === */
        .analog-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 2rem 20px 2rem;
            gap: 0.3rem;
        }
        .analog-title {
            font-family: "IBM Plex Mono", monospace;
            font-size: clamp(1rem, 3vw, 1.4rem);
            letter-spacing: 0.2em;
            color: var(--text-primary);
        }
        .analog-sub {
            font-family: "IBM Plex Mono", monospace;
            font-size: 0.7rem;
            color: var(--text-secondary);
            letter-spacing: 0.15em;
        }

        /* === PHOTO GRID === */
        /* Sol LeWitt: strict 4-column, square cells, thin uniform gaps */
        .photo-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 3px;
            padding: 0 3px 3px;
            background: white;
        }

        .grid-cell {
            aspect-ratio: 1 / 1;
            overflow: hidden;
            background: var(--bg-secondary);
            border: none;
            padding: 0;
            cursor: pointer;
            display: block;
        }

        .grid-cell img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.3s ease;
        }
        .grid-cell:hover img {
            transform: scale(1.04);
        }

        /* === LIGHTBOX === */
        .lightbox {
            position: fixed;
            inset: 0;
            background: black;
            z-index: 1000;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .lightbox.open {
            display: flex;
        }

        .lightbox-track {
            display: flex;
            width: 100%;
            height: 100%;
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .lightbox-slide {
            min-width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem;
        }
        .lightbox-slide img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            user-select: none;
        }

        .lightbox-close {
            position: fixed;
            top: 20px;
            right: 24px;
            background: none;
            border: none;
            color: white;
            font-size: 1.4rem;
            cursor: pointer;
            z-index: 10;
            opacity: 0.6;
            transition: opacity 0.2s;
        }
        .lightbox-close:hover {
            opacity: 1;
        }

        .lightbox-arrow {
            position: fixed;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: white;
            font-size: 1.8rem;
            cursor: pointer;
            z-index: 10;
            opacity: 0.4;
            transition: opacity 0.2s;
            padding: 1rem;
        }
        .lightbox-arrow:hover {
            opacity: 1;
        }
        .lightbox-arrow.left {
            left: 12px;
        }
        .lightbox-arrow.right {
            right: 12px;
        }

        .lightbox-counter {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            font-family: "IBM Plex Mono", monospace;
            font-size: 0.75rem;
            color: #666;
            letter-spacing: 0.1em;
        }

        /* === MOBILE === */
        @media (max-width: 600px) {
            .analog-header {
                padding-top: 1.5rem;
            }
            .lightbox-slide {
                padding: 1rem;
            }
        }
    </style>

    <!-- ─── SCRIPTS ───────────────────────────────────────────── -->
    <script>
        const total = document.querySelectorAll(".grid-cell").length;
        const lightbox = document.getElementById("lightbox") as HTMLElement;
        const track = document.getElementById("lightbox-track") as HTMLElement;
        const counter = document.getElementById(
            "lightbox-counter",
        ) as HTMLElement;
        let current = 0;

        // ── OPEN lightbox at clicked photo ──
        document.querySelectorAll(".grid-cell").forEach((btn) => {
            btn.addEventListener("click", () => {
                current = parseInt((btn as HTMLElement).dataset.index!);
                lightbox.classList.add("open");
                lightbox.setAttribute("aria-hidden", "false");
                goTo(current, false);
            });
        });

        // ── NAVIGATE ──
        function goTo(index: number, animate = true) {
            current = Math.max(0, Math.min(index, total - 1));
            if (!animate) track.style.transition = "none";
            track.style.transform = `translateX(-${current * 100}%)`;
            if (!animate)
                requestAnimationFrame(() => {
                    track.style.transition = "";
                });
            counter.textContent = `${current + 1} / ${total}`;
        }

        document
            .getElementById("lightbox-prev")!
            .addEventListener("click", () => goTo(current - 1));
        document
            .getElementById("lightbox-next")!
            .addEventListener("click", () => goTo(current + 1));

        // ── CLOSE ──
        function closeLightbox() {
            lightbox.classList.remove("open");
            lightbox.setAttribute("aria-hidden", "true");
        }

        document
            .getElementById("lightbox-close")!
            .addEventListener("click", closeLightbox);
        lightbox.addEventListener("click", (e) => {
            if (e.target === lightbox) closeLightbox();
        });
        document.addEventListener("keydown", (e) => {
            if (!lightbox.classList.contains("open")) return;
            if (e.key === "ArrowRight") goTo(current + 1);
            if (e.key === "ArrowLeft") goTo(current - 1);
            if (e.key === "Escape") closeLightbox();
        });
    </script>
</BaseLayout>
