---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — Velvet Coke">
  <main class="container">
    <div class="left">
      <img src="/images/dantell.jpg" alt="DANTELL" class="main-image" />
      <p class="label">DANTELL</p>
    </div>
    <div class="right">
      <p class="punch">Welcome to the world of Velvet Coke</p>
      <p class="bio">
        Velvet Coke is a creative hub where electronic music passion meets a
        passion of photography. It contains the works of Artist and Founder
        Dantell. Here you will find three distinct pages, Music, Photography
        and Poems. Music is where Dantell shares his productions and mixes.
        Photography is where Dantell shares his analog photographs from
        around the world, nightlife, street and soul. Lastly the poems page
        is where you can find Dantell's ongoing writing.
      </p>
      <p>
        <strong>Contact:</strong><br />
        For collaborative work, music releases, demo submissions and general
        questions, email velvetcokeee@gmail.com
      </p>
      <p class="closing">Enjoy your stay</p>
    </div>
  </main>

  <style>
    .container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 40px;
      padding: 40px 20px 60px;
    }
    .left,
    .right {
      max-width: 400px;
    }
    .label {
      text-align: center;
    }
    .main-image {
      width: 300px;
      height: auto;
      display: block;
      margin: 0 auto;
    }
    .closing {
      font-style: italic;
      color: var(--text-secondary);
    }
  </style>
</BaseLayout>
